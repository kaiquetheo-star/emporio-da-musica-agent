# ── LLM provider (OpenAI-compatible interface) ────────────────────────────
# Option A — OpenRouter (recommended: swap models/providers with one var)
#   Get a key at https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-your-openrouter-key
# Any tool-calling capable model id from the provider, e.g.:
#   google/gemini-2.5-flash | anthropic/claude-sonnet-4.5 | openai/gpt-4.1
LLM_MODEL=google/gemini-2.5-flash

# Option B — Google Gemini directly (OpenAI-compatible endpoint)
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=your-gemini-api-key
#   LLM_MODEL=gemini-2.5-flash

# ── Runtime ────────────────────────────────────────────────────────────────
# Max turns the agent may take per user message (tool-call loop safety bound)
AGENT_MAX_TURNS=6
